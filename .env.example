# Copy to .env.local. Use the same names in the Vercel project.
# .env.local stays off git.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Canonical public URL (guest QR PNGs, owner portal links). Production: https://www.zustscan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ZUST_PORTAL_SECRET=
# Guest review drafts — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini — fastest/cheapest for short drafts)
# AI_DRAFT_MODEL=

# Performance: host Supabase in the same region as Vercel (e.g. Mumbai ap-south-1).
# Cross-region DB adds 1–3s on every guest scan and draft request.
