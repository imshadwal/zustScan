# Copy to .env.local. Use the same names in the Vercel project.
# .env.local stays off git.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
